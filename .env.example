# Copiază fișierul:  cp .env.example .env
# DOAR valori de dezvoltare. Nu pune aici secrete reale; .env este ignorat de git.
# Valorile implicite din application.yml sunt identice, deci serviciile pornesc și din IntelliJ fără .env.

# ---------- MySQL (un container, o schemă + un utilizator per serviciu) ----------
MYSQL_ROOT_PASSWORD=root-dev-password
USER_DB_USERNAME=user_service
USER_DB_PASSWORD=user-service-dev-pw
AUCTION_DB_USERNAME=auction_service
AUCTION_DB_PASSWORD=auction-service-dev-pw
BIDDING_DB_USERNAME=bidding_service
BIDDING_DB_PASSWORD=bidding-service-dev-pw

# ---------- Securitate ----------
# HS256 cere minimum 32 de octeți.
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789abcdef
JWT_EXPIRATION_MINUTES=60
# Cheie partajată pentru apelurile /internal/** dintre servicii (header X-Internal-Key).
INTERNAL_API_KEY=dev-only-internal-api-key

# ---------- URL-uri servicii ----------
# Folosite la rularea din IntelliJ. În Docker Compose sunt setate explicit cu numele containerelor.
USER_SERVICE_URL=http://localhost:8081
AUCTION_SERVICE_URL=http://localhost:8082
BIDDING_SERVICE_URL=http://localhost:8083
NOTIFICATION_SERVICE_URL=http://localhost:8084
NOTIFICATION_SERVICE_WS_URL=ws://localhost:8084

# ---------- CORS / WebSocket ----------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
WS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,http://127.0.0.1:*
