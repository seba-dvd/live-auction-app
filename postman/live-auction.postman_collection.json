      "name": "auction-service",
      "item": [
        {
          "id": "2ffb5905-2b5e-5dc1-8271-15d37e417bcd",
          "name": "Create auction",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auctions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auctions"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Vintage camera\",\n  \"description\": \"Working condition, original case.\",\n  \"startingPrice\": 100,\n  \"minIncrement\": 10,\n  \"startTime\": \"{{startTime}}\",\n  \"endTime\": \"{{endTime}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// start in 1 minute, end in 10 minutes (ISO-8601, UTC)",
                  "pm.collectionVariables.set('startTime', new Date(Date.now() + 60 * 1000).toISOString());",
                  "pm.collectionVariables.set('endTime', new Date(Date.now() + 10 * 60 * 1000).toISOString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) { pm.collectionVariables.set('auctionId', pm.response.json().id); }"
                ]
              }
            }
          ]
        },
