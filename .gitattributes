# Normalize line endings: LF in the repository and in the working tree (Windows included).
* text=auto eol=lf

# Windows scripts keep CRLF.
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary files: never touch.
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.docx binary
*.xlsx binary
*.pptx binary
*.zip binary
*.woff binary
*.woff2 binary
*.ttf binary
